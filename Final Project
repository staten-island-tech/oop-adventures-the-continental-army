class Hunter:
    def __init__(self,name,health = 100, stamina = 100):
        self.name = name
        self.health = health
        self.stamina = stamina

    
    def attack(self):
        self.stamina -= 10
        self.health += 3
    
    def defend(self):
        self.stamina -= 15
        self.health -= 3   

