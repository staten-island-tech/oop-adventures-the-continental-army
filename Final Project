class Hunter:
    def __init__(self, name,health = 100, stamina = 100, living = True):
        self.name = name
        self.health = health
        self.stamina = stamina

    def attack(self):
        self.stamina -= 10
        self.health += 3
    
    def defend(self):
        self.stamina -= 15
        self.health -= 3
    
    def dead(self):
        health = 0
        stamina = 0
        living = False

